NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Sentry error reporting (off when unset). Project DSN from sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.us.sentry.io/0
# Build only (Vercel): uploads source maps to Sentry; never commit it
SENTRY_AUTH_TOKEN=
# CLI/scripts only (supabase db push --db-url, npm run test:sql) — never read by the app
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
